export component AppWindow inherits Window {
    in-out property <string> time-text: "00:00";
    in-out property <string> seconds-text: "00";
    in-out property <string> date-weekday-text: "0000年00月00日 · 星期一";
    in-out property <string> reading-content: "读书不觉已春深，一寸光阴一寸金。";
    in-out property <string> reading-source: "王贞白《白鹿洞二首·其一》 · 读书";
    in-out property <bool> focus-active: false;
    in-out property <color> canvas-color: #e2dbcc;
    in-out property <color> wash-primary-color: #ad9a7b38;
    in-out property <color> wash-secondary-color: #798e8320;
    in-out property <color> text-primary-color: #463c2f;
    in-out property <color> text-muted-color: #6f6657;
    in-out property <color> accent-color: #997c53;
    in-out property <int> scene-variant: 0;
    in-out property <bool> night-mode: false;
    in-out property <string> ui-font-family: "WenQuanYi Zen Hei";

    callback screen-tapped();

    preferred-width: 800px;
    preferred-height: 480px;
    background: root.canvas-color;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.canvas-color;

        Rectangle {
            x: root.scene-variant == 0 ? -28px :
               root.scene-variant == 1 ? 384px :
               root.scene-variant == 2 ? 72px : 448px;
            y: root.scene-variant == 0 ? -42px :
               root.scene-variant == 1 ? -34px :
               root.scene-variant == 2 ? 228px : 188px;
            width: root.scene-variant == 2 ? 328px : 352px;
            height: root.scene-variant == 0 ? 208px :
                root.scene-variant == 1 ? 236px :
                root.scene-variant == 2 ? 176px : 202px;
            border-radius: 44px;
            background: root.wash-primary-color;
        }

        Rectangle {
            x: root.scene-variant == 0 ? 476px :
               root.scene-variant == 1 ? 52px :
               root.scene-variant == 2 ? 430px : 18px;
            y: root.scene-variant == 0 ? 48px :
               root.scene-variant == 1 ? 266px :
               root.scene-variant == 2 ? 18px : 298px;
            width: root.scene-variant == 3 ? 288px : 264px;
            height: root.scene-variant == 0 ? 176px :
                root.scene-variant == 1 ? 152px :
                root.scene-variant == 2 ? 206px : 150px;
            border-radius: 56px;
            background: root.wash-secondary-color;
        }

        Rectangle {
            x: root.scene-variant == 0 ? 564px :
               root.scene-variant == 1 ? 538px :
               root.scene-variant == 2 ? -18px : 516px;
            y: root.scene-variant == 0 ? 286px :
               root.scene-variant == 1 ? 120px :
               root.scene-variant == 2 ? 76px : 16px;
            width: root.scene-variant == 2 ? 244px : 216px;
            height: root.scene-variant == 0 ? 150px :
                root.scene-variant == 1 ? 216px :
                root.scene-variant == 2 ? 164px : 244px;
            border-radius: 52px;
            background: root.wash-primary-color;
        }

        Text {
            x: 64px;
            y: 38px;
            width: 420px;
            height: 28px;
            text: root.date-weekday-text;
            color: root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 22px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Text {
            x: 58px;
            y: 68px;
            width: 356px;
            height: 132px;
            text: root.time-text;
            color: root.text-primary-color;
            font-family: root.ui-font-family;
            font-size: 112px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Text {
            x: 424px;
            y: 112px;
            width: 38px;
            height: 26px;
            text: root.seconds-text;
            color: root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 22px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Text {
            x: 64px;
            y: 238px;
            width: 92px;
            height: 26px;
            text: "今日一页";
            color: root.accent-color;
            font-family: root.ui-font-family;
            font-size: 20px;
            font-weight: 600;
            vertical-alignment: center;
        }

        Rectangle {
            x: 168px;
            y: 250px;
            width: 42px;
            height: 3px;
            border-radius: 2px;
            background: root.accent-color;
        }

        Text {
            x: 64px;
            y: 270px;
            width: 650px;
            height: 104px;
            text: root.reading-content;
            color: root.focus-active ? root.text-muted-color : root.text-primary-color;
            font-family: root.ui-font-family;
            font-size: 31px;
            font-weight: 500;
            wrap: word-wrap;
            overflow: clip;
        }

        Text {
            x: 64px;
            y: 382px;
            width: 672px;
            height: 28px;
            text: root.reading-source;
            color: root.focus-active ? root.text-muted-color : root.text-primary-color;
            font-family: root.ui-font-family;
            font-size: 20px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: clip;
        }

        Text {
            x: 64px;
            y: 430px;
            width: 672px;
            height: 26px;
            text: root.focus-active ? "已经开始了，先读一页就好" : "轻触一下，先读一页";
            color: root.focus-active ? root.text-primary-color : root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 20px;
            font-weight: 500;
            vertical-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.screen-tapped();
            }
        }
    }
}
