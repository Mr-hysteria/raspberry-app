export component AppWindow inherits Window {
    in-out property <string> time-text: "00:00";
    in-out property <string> seconds-text: "00";
    in-out property <string> date-weekday-text: "0000年00月00日 · 星期一";
    in-out property <string> reading-content: "读书不觉已春深，一寸光阴一寸金。";
    in-out property <string> reading-source: "王贞白《白鹿洞二首·其一》 · 读书";
    in-out property <bool> focus-active: false;
    in-out property <color> canvas-color: #ebe7de;
    in-out property <color> surface-color: #f9f6ef;
    in-out property <color> rule-color: #86755848;
    in-out property <color> text-primary-color: #2a2926;
    in-out property <color> text-muted-color: #6b655b;
    in-out property <color> accent-color: #8f6944;
    in-out property <int> scene-variant: 0;
    in-out property <bool> night-mode: false;
    in-out property <string> ui-font-family: "WenQuanYi Zen Hei";

    callback screen-tapped();

    preferred-width: 800px;
    preferred-height: 480px;
    background: root.canvas-color;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.canvas-color;

        // A quiet tonal field replaces the old floating cards.
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: @linear-gradient(135deg, #00000000 0%, #00000000 58%, root.rule-color 100%);
        }

        // Cropped hairline disc: a print-like motif rather than decoration blocks.
        Rectangle {
            x: root.scene-variant == 0 ? 636px :
               root.scene-variant == 1 ? 586px :
               root.scene-variant == 2 ? 648px : 606px;
            y: root.scene-variant == 0 ? -124px :
               root.scene-variant == 1 ? -154px :
               root.scene-variant == 2 ? -108px : -138px;
            width: 272px;
            height: 272px;
            border-radius: 136px;
            border-width: 1px;
            border-color: root.rule-color;
            background: #00000000;
        }

        Rectangle {
            x: 64px;
            y: 38px;
            width: 1px;
            height: 28px;
            background: root.accent-color;
        }

        Text {
            x: 78px;
            y: 38px;
            width: 410px;
            height: 28px;
            text: root.date-weekday-text;
            color: root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 19px;
            font-weight: 400;
            vertical-alignment: center;
        }

        Text {
            x: 546px;
            y: 39px;
            width: 188px;
            height: 24px;
            text: "DAILY READING";
            color: root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 13px;
            font-weight: 400;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        Text {
            x: 58px;
            y: 70px;
            width: 344px;
            height: 112px;
            text: root.time-text;
            color: root.text-primary-color;
            font-family: root.ui-font-family;
            font-size: 98px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Text {
            x: 392px;
            y: 121px;
            width: 36px;
            height: 24px;
            text: root.seconds-text;
            color: root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 19px;
            font-weight: 400;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            x: 64px;
            y: 198px;
            width: 670px;
            height: 1px;
            background: root.rule-color;
        }

        Rectangle {
            x: 726px;
            y: 194px;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: root.focus-active ? root.accent-color : root.rule-color;
        }

        // The only card is meaningful: it is the reading sheet.
        Rectangle {
            x: 48px;
            y: 222px;
            width: 704px;
            height: 196px;
            border-radius: 14px;
            border-width: 1px;
            border-color: root.focus-active ? root.accent-color : root.rule-color;
            background: root.surface-color;

            Rectangle {
                x: 0;
                y: root.focus-active ? 0 : 24px;
                width: root.focus-active ? 3px : 1px;
                height: root.focus-active ? parent.height : 148px;
                border-radius: 2px;
                background: root.focus-active ? root.accent-color : root.rule-color;
            }
        }

        Text {
            x: 72px;
            y: 242px;
            width: 88px;
            height: 24px;
            text: "今日一页";
            color: root.accent-color;
            font-family: root.ui-font-family;
            font-size: 16px;
            font-weight: 500;
            vertical-alignment: center;
        }

        Rectangle {
            x: 158px;
            y: 254px;
            width: 38px;
            height: 1px;
            background: root.accent-color;
        }

        Text {
            x: 72px;
            y: 278px;
            width: 644px;
            height: 72px;
            text: root.reading-content;
            color: root.text-primary-color;
            font-family: root.ui-font-family;
            font-size: 34px;
            font-weight: 500;
            wrap: word-wrap;
            overflow: clip;
        }

        Text {
            x: 72px;
            y: 366px;
            width: 644px;
            height: 26px;
            text: root.reading-source;
            color: root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 18px;
            font-weight: 400;
            vertical-alignment: center;
            overflow: clip;
        }

        Text {
            x: 64px;
            y: 434px;
            width: 672px;
            height: 26px;
            text: root.focus-active ? "已经开始了，先读一页就好" : "轻触一下，先读一页";
            color: root.focus-active ? root.accent-color : root.text-muted-color;
            font-family: root.ui-font-family;
            font-size: 18px;
            font-weight: 400;
            vertical-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                root.screen-tapped();
            }
        }
    }
}
